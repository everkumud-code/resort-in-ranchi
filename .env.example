# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resort_in_ranchi?schema=public"

# Used ONLY by `npm run admin:bootstrap` to create/update the first admin
# user. Not read anywhere else — admin login always checks the database,
# never these env vars directly. Change/remove these after bootstrapping.
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="change-me-min-8-chars"
ADMIN_BOOTSTRAP_NAME="Admin"

# Public base URL used to build canonical links, Open Graph URLs and the
# sitemap. Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# "Forgot password" e-mails are sent through a Gmail account using an APP
# PASSWORD (not the normal Gmail password). Create one at Google Account >
# Security > 2-Step Verification > App passwords. Spaces in it are ignored.
# Without these two, no reset e-mail is sent (in local development the reset
# link is printed in the terminal instead).
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional: the sender name people see (default "ResortInRanchi").
SMTP_FROM_NAME=
